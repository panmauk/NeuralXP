/* NeuralXP resource file */
#include <windows.h>

/* Application icon */
1 ICON "neuralxp.ico"

/* Version info */
1 VERSIONINFO
FILEVERSION 1,0,3,0
PRODUCTVERSION 1,0,3,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Panmox"
            VALUE "FileDescription", "NeuralXP - Offline AI for Windows XP"
            VALUE "FileVersion", "1.0.3"
            VALUE "InternalName", "NeuralXP"
            VALUE "LegalCopyright", "Copyright (C) 2026 Panmox. GPL v3."
            VALUE "OriginalFilename", "NeuralXP.exe"
            VALUE "ProductName", "NeuralXP"
            VALUE "ProductVersion", "1.0.3"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
